{
  "collector": {
    "sources": ["hf-daily", "arxiv"],
    "keywords": [
      "GUI agent", "computer use", "web agent", "mobile agent",
      "VLM", "vision language model", "multimodal",
      "LLM agent", "agentic RL", "world model","hyperbolic","Embodied AI", "Visual Imitation Learning", "Reinforcement Learning",
      "self-evolving", "self-improving agent"
    ],
    "days": 3,
    "min_score": 2,
    "top_n": 30
  },
  "digest": {
    "parallel_limit": 4,
    "prepare_parallel_limit": 2,
    "review_parallel_limit": 2,
    "timeout_minutes": 12,
    "retry_limit": 2
  },
  "orchestration": {
    "checkpoint_every": 3,
    "max_papers_per_run": 20,
    "max_search_queries": 10,
    "post_verification_queries": 3,
    "post_verification_loops": 1,
    "synthesis_min_committed": 3,
    "max_wall_minutes": 90
  },
  "model_policy": {
    "finder": {
      "tier": "cheap-fast"
    },
    "digest": {
      "tier": "balanced"
    },
    "verifier": {
      "tier": "strong",
      "require_different_agent": true,
      "hide_finder_reasoning": true
    },
    "judge": {
      "tier": "strongest-available",
      "trigger": "disputed-high-impact-only"
    },
    "synthesis": {
      "tier": "strong"
    }
  },
  "survey": {
    "min_papers": 15,
    "output_dir": "Topics/",
    "sections": ["background", "methods", "benchmarks", "challenges", "future"]
  },
  "report": {
    "frequency": "daily",
    "output_dir": "Reports/"
  },
  "interests": [
    {
      "name": "GUI Agent",
      "keywords": [
        "GUI agent", "computer use", "computer-use", "web agent", "browser agent",
        "mobile agent", "desktop agent", "OS agent", "GUI grounding", "screen grounding",
        "GUI agent reinforcement learning", "GUI environment", "GUI verifier",
        "GUI agent reliability", "GUI safety", "agent benchmark"
      ]
    },
    {
      "name": "VLM / Multimodal",
      "keywords": ["VLM", "vision language model", "vision-language model", "multimodal LLM", "visual reasoning", "visual grounding", "video understanding"]
    },
    {
      "name": "AI Agent",
      "keywords": ["LLM agent", "agentic RL", "agentic reinforcement learning", "tool use", "world model", "self-evolving", "self-improving agent", "misevolution", "agent memory evolution", "skill library"]
    },
    {
      "name": "Embodied AI",
      "keywords": ["Embodied AI", "VLA", "vision-language-action", "diffusion policy", "imitation learning", "manipulation", "navigation", "sim-to-real"]
    }
  ],
  "news": {
    "sources": [
      {"name": "HuggingFace Blog", "type": "rss", "url": "https://huggingface.co/blog/feed.xml", "lang": "en"},
      {"name": "Anthropic News", "type": "web", "url": "https://www.anthropic.com/news", "lang": "en"},
      {"name": "机器之心", "type": "web", "url": "https://www.jiqizhixin.com/", "lang": "zh"}
    ],
    "days": 3,
    "min_score": 1,
    "top_n": 20,
    "wechat": {
      "enabled": true,
      "accounts": ["机器之心", "量子位", "新智元", "PaperWeekly"],
      "keywords": [
        "具身智能", "VLA", "机器人操作",
        "视觉语言模型", "多模态大模型", "视觉推理",
        "GUI智能体", "电脑操作智能体", "手机智能体",
        "大模型智能体", "智能体强化学习", "世界模型"
      ],
      "per_keyword": 10,
      "max_queries": 12,
      "whitelist_only": true,
      "query_delay_sec": 1.5
    }
  }
}
